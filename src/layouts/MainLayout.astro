---
import MobileActions from '../components/MobileActions.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content, locales, localePath, site, type Locale } from '../data/site';
import '../styles/global.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="robots" content={Astro.site ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && locales.map((lang) => <link rel="alternate" hreflang={lang} href={new URL(localePath(lang), Astro.site).href} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={{ it: 'it_IT', en: 'en_GB', de: 'de_DE' }[locale]} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f4ec" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer locale={locale} />
    <MobileActions locale={locale} />
  </body>
</html>
