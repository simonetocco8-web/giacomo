---
import { site, content, locales, languageNames, navigation, ui, localePath, galleryPath, type Locale } from '../data/site';
interface Props { locale: Locale; page?: 'home' | 'gallery' }
const { locale, page = 'home' } = Astro.props;
const menuHref = (id: string) => id === 'gallery' ? galleryPath(locale) : `${page === 'home' ? '' : localePath(locale)}#${id}`;
const t = content[locale];
const labels: Record<string, string> = { hero: ui[locale].home, rooms: t.sections[1], gallery: t.sections[3], services: t.sections[2], destination: t.sections[4], location: t.sections[6] };
---
<header class="site-header">
 <div class="shell header-row">
  <a class="brand" href={localePath(locale)}>{site.shortName}<span>{site.destination} · {site.region}</span></a>
  <nav class="desktop-nav" aria-label={t.menu}><ul>{navigation.map((id) => <li><a href={menuHref(id)} aria-current={id === 'gallery' && page === 'gallery' ? 'page' : undefined}>{labels[id]}</a></li>)}</ul></nav>
  <a class="button header-book" href={site.bookingUrl}>{t.book}</a>
  <details class="navigation"><summary>{t.menu}</summary>
   <nav aria-label={t.menu}><ul>{navigation.map((id) => <li><a href={menuHref(id)} aria-current={id === 'gallery' && page === 'gallery' ? 'page' : undefined}>{labels[id]}</a></li>)}</ul></nav>
  </details>
  <nav class="languages" aria-label="Lingua / Language / Sprache">{locales.map(lang => <a href={page === 'gallery' ? galleryPath(lang) : localePath(lang)} lang={lang} hreflang={lang} aria-label={`${lang.toUpperCase()} — ${languageNames[lang]}`} aria-current={lang === locale ? 'page' : undefined}>{lang.toUpperCase()}</a>)}</nav>
 </div>
</header>
