---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  hero?: boolean;
  webp?: string;
  avif?: string;
  srcset?: string;
  sizes: string;
  position?: string;
}
const { src, alt, width, height, hero = false, webp, avif, srcset, sizes, position = '50% 50%' } = Astro.props;
---
<figure class:list={['visual', { 'hero-visual': hero }]}>
  <picture>
    {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
    {webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
    <img src={src} srcset={srcset} sizes={sizes} alt={alt} width={width} height={height} style={`object-position: ${position}`} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async" />
  </picture>
</figure>
