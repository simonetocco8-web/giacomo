---
import { site, content, ui, type Locale } from '../data/site';
import { homepageCopy } from '../data/homepage-copy';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<footer class="shell footer">
 <p>{site.name} · {site.location}</p>
 {site.address && <p>{site.address}</p>}
 {site.cin && <p>CIN: {site.cin}</p>}
 {site.cir && <p>CIR: {site.cir}</p>}
 <nav class="footer-links" aria-label={content[locale].sections[6]}>
  <a href={site.bookingUrl}>{content[locale].book}</a>
  <a href={site.quoteUrl}>{ui[locale].quote}</a>
  <a href={site.mapsUrl}>{ui[locale].maps}</a>
  <a href={site.facebookUrl}>Facebook</a>
  {site.whatsappUrl && <a href={site.whatsappUrl}>WhatsApp</a>}
  {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
  {site.phone && <a href={site.phoneUrl}>{homepageCopy[locale].call}: {site.phone}</a>}
 </nav>
</footer>
