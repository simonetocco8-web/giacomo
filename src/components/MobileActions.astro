---
import { site, content, ui, type Locale } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<aside class="mobile-actions" aria-label={content[locale].book}>
 {site.whatsappUrl ? <a href={site.whatsappUrl}>WhatsApp</a> : <button disabled>WhatsApp</button>}
 <a href={site.quoteUrl}>{ui[locale].quote}</a>
 <a class="mobile-book" href={site.bookingUrl}>{content[locale].book}</a>
</aside>
