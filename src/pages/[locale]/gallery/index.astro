---
import GalleryPage from '../../../components/GalleryPage.astro';
import { locales, type Locale } from '../../../data/site';
export function getStaticPaths() { return locales.filter(locale => locale !== 'it').map(locale => ({ params: { locale }, props: { locale } })); }
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<GalleryPage locale={locale} />
