---
import MainLayout from '../../layouts/MainLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { content, locales, site, ui, type Locale } from '../../data/site';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale }, props: { locale } })); }
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale]; const u = ui[locale];
---
<MainLayout locale={locale}>
 <section id="hero" class="hero" aria-labelledby="hero-title">
  <ResponsiveImage hero alt="" label={u.photo} />
  <div class="shell hero-copy"><p class="eyebrow">{site.location}</p><h1 id="hero-title">Villa<br/>Maria Elena</h1><p class="lead">{t.intro}</p><a class="button button-light" href={site.contactUrl}>{t.book}</a><a class="hero-explore" href="#presentation">{u.explore} ↓</a></div>
 </section>
 <section id="presentation" class="section shell intro" aria-labelledby="presentation-title"><p class="eyebrow">Villa Maria Elena</p><h2 id="presentation-title">{t.sections[0]}</h2><p class="lead">{t.intro}</p><p class="muted">{t.placeholder}</p></section>
 <section id="rooms" class="section section-tinted" aria-labelledby="rooms-title"><div class="shell"><div class="section-heading"><div><p class="eyebrow">01 / Villa Maria Elena</p><h2 id="rooms-title">{t.sections[1]}</h2></div><a class="text-link" href="#booking">{u.quote} ↗</a></div><div class="room-grid">{[1,2].map(i => <article class="room-card"><ResponsiveImage alt="" label={`${u.room} ${i} · ${u.photo}`} /><p>{t.placeholder}</p></article>)}</div></div></section>
 <section id="services" class="section shell" aria-labelledby="services-title"><p class="eyebrow">02 / Villa Maria Elena</p><h2 id="services-title">{t.sections[2]}</h2><div class="service-grid">{[1,2,3].map(i => <div class="service-slot"><span aria-hidden="true">0{i}</span><p>{u.service}</p></div>)}</div></section>
 <section id="gallery" class="section section-tinted" aria-labelledby="gallery-title"><div class="shell"><p class="eyebrow">03 / Villa Maria Elena</p><h2 id="gallery-title">{t.sections[3]}</h2><div class="gallery-grid">{[1,2,3].map(i => <ResponsiveImage alt="" label={`${u.gallery} ${i} · ${u.photo}`} />)}</div></div></section>
 <section id="destination" class="section shell destination" aria-labelledby="destination-title"><ResponsiveImage alt="" label={u.photo} /><div><p class="eyebrow">Calabria</p><h2 id="destination-title">Capo Vaticano<br/><span class="muted">Costa degli Dei</span></h2><p>{t.intro}</p><p class="muted">{t.placeholder}</p></div></section>
 <section id="reviews" class="section section-tinted reviews" aria-labelledby="reviews-title"><div class="shell"><p class="eyebrow">Villa Maria Elena</p><h2 id="reviews-title">{t.sections[5]}</h2><p>{u.review}</p></div></section>
 <section id="location" class="section shell destination" aria-labelledby="location-title"><div><p class="eyebrow">Capo Vaticano · Calabria</p><h2 id="location-title">{t.sections[6]}</h2><p>{site.location}</p><p class="muted">{u.map}</p></div><div class="map-placeholder"><span aria-hidden="true">＋</span><p>{u.map}</p></div></section>
 <section id="booking" class="section booking" aria-labelledby="booking-title"><div class="shell"><p class="eyebrow">Villa Maria Elena</p><h2 id="booking-title">{t.sections[7]}</h2><p>{t.placeholder}</p><a class="button button-light" href={site.contactUrl}>{t.book} ↗</a></div></section>
</MainLayout>
